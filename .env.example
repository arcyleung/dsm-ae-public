# Copy to .env and adjust (docker compose loads .env automatically)

# Browser path prefix when reverse-proxied (leave /dsm-ae for funnel-style setups)
DSM_AE_PUBLIC_BASE=/dsm-ae

# Host port published by compose
DSM_AE_PUBLISH_PORT=8765

# Shared secret for enqueue/cancel/retry in the WebUI (recommended in production)
DSM_AE_QUEUE_TOKEN=

# Embedded worker (1=on). Set 0 to serve UI only and run workers elsewhere.
DSM_AE_WITH_WORKER=1
DSM_AE_WORKER_POLL=2
DSM_AE_STALE_SECONDS=3600

# Optional provider env keys (also set per-model keys in models.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DSM_AE_API_KEY=
